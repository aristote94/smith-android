<?xml version="1.0" encoding="utf-8"?>
<!--
    Équivalent de data_extraction_rules.xml pour Android 11 et antérieur.
    `allowBackup="false"` suffirait, mais l'expliciter évite qu'un futur passage à
    `true` réactive silencieusement la sauvegarde de données qui n'existent pas.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
